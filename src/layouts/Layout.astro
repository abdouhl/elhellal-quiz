---
import "@new-ui/foundations";

export interface Props {
    pageTitle: string;
    pageDescription: string;
    canonicalUrl?: string;
    ogImage?: string;
    noindex?: boolean;
}

const { pageTitle, pageDescription, canonicalUrl, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" data-new-ui-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="اختبار الهلال" />
    <link rel="preload" href="/woffs/ROM-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/woffs/ROM-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abdou_hll" />
    <!-- Google AdSense (same publisher account as elhellal.com) -->
    <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3610150616518651"
        crossorigin="anonymous"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">التخطي إلى المحتوى الرئيسي</a>

    <slot />

    <footer class="site-footer">
        <a href="https://elhellal.com">الهلال</a>
    </footer>

    <script is:inline>
        if ("serviceWorker" in navigator) {
            addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
        }
    </script>
</body>
</html>

<style is:global>
    @font-face {
        font-family: "ROM-Regular";
        src: url("/woffs/ROM-Regular.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Bold";
        src: url("/woffs/ROM-Bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
    }
    :root {
        --body-copy: "ROM-Regular", var(--system-ui);
        --body-strong: "ROM-Bold", var(--system-ui);
        --right: #3ecf8e;
        --wrong: #ff5c5c;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }
    html[data-new-ui-theme*="dark"] {
        --link: DarkOrange;
        --link-hover: DarkOrange;
        --border-focus: DarkOrange;
    }
    html {
        font-family: var(--body-copy);
        background-color: var(--background-high-contrast);
    }
    body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        font-family: var(--body-copy);
        min-height: 100vh;
        color: var(--content-primary);
        background: var(--background-high-contrast);
    }
    a {
        color: inherit;
    }
    h1, h2, h3 {
        font-family: var(--body-strong);
        font-weight: 500;
    }
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        padding: 8px 16px;
        background: var(--background);
        color: var(--link);
        z-index: 9999;
    }
    .skip-link:focus {
        top: 8px;
    }
    .site-footer {
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }
    .site-footer a {
        color: var(--content-secondary);
        text-decoration: none;
    }
    .site-footer a:hover {
        color: var(--link);
    }
</style>
