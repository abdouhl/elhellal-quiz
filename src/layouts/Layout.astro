---
import "@new-ui/foundations";

export interface Props {
    pageTitle: string;
    pageDescription: string;
    canonicalUrl?: string;
    ogImage?: string;
    noindex?: boolean;
}

const { pageTitle, pageDescription, canonicalUrl, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" data-new-ui-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="اختبار الهلال" />
    <link rel="preload" href="/woffs/ROM-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/woffs/ROM-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abdou_hll" />
    <!-- Google AdSense (same publisher account as elhellal.com) -->
    <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3610150616518651"
        crossorigin="anonymous"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">التخطي إلى المحتوى الرئيسي</a>

    <slot />

    <footer class="site-footer">
        <a href="/c/">كل الأسئلة</a>
        <a href="https://elhellal.com">الهلال</a>
    </footer>

    <div class="install-cta" id="install-cta" role="dialog" aria-labelledby="install-cta-title" hidden>
        <img src="/icon-192.png" alt="" width="40" height="40" />
        <div class="install-cta-text">
            <strong id="install-cta-title">ثبّت اختبار الهلال</strong>
            <span id="install-cta-desc">العب بسرعة من شاشتك الرئيسية، حتى بدون إنترنت.</span>
        </div>
        <button type="button" class="install-cta-btn" id="install-cta-btn">تثبيت</button>
        <button type="button" class="install-cta-close" id="install-cta-close" aria-label="إغلاق">×</button>
    </div>

    <script is:inline>
        if ("serviceWorker" in navigator) {
            addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
        }

        (() => {
            const KEY = "install-cta-dismissed";
            const SNOOZE_MS = 7 * 24 * 60 * 60 * 1000;
            const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
            const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
                (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
            if (standalone || !mobile) return;
            try {
                if (Date.now() - Number(localStorage.getItem(KEY) || 0) < SNOOZE_MS) return;
            } catch {}

            const cta = document.getElementById("install-cta");
            const btn = document.getElementById("install-cta-btn");
            const desc = document.getElementById("install-cta-desc");
            const hide = (remember) => {
                cta.hidden = true;
                if (remember) try { localStorage.setItem(KEY, String(Date.now())); } catch {}
            };
            document.getElementById("install-cta-close").addEventListener("click", () => hide(true));

            const ios = /iPhone|iPad|iPod/i.test(navigator.userAgent) || navigator.maxTouchPoints > 1 && navigator.platform === "MacIntel";
            if (ios) {
                // iOS has no install prompt API: show manual instructions instead.
                desc.textContent = "اضغط على زر المشاركة ⎋ ثم «إضافة إلى الشاشة الرئيسية».";
                btn.hidden = true;
                setTimeout(() => (cta.hidden = false), 3000);
                return;
            }

            let deferred;
            addEventListener("beforeinstallprompt", (e) => {
                e.preventDefault();
                deferred = e;
                cta.hidden = false;
            });
            btn.addEventListener("click", async () => {
                if (!deferred) return;
                deferred.prompt();
                const { outcome } = await deferred.userChoice;
                deferred = null;
                hide(outcome !== "accepted");
            });
            addEventListener("appinstalled", () => hide(false));
        })();
    </script>
</body>
</html>

<style is:global>
    @font-face {
        font-family: "ROM-Regular";
        src: url("/woffs/ROM-Regular.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Bold";
        src: url("/woffs/ROM-Bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
    }
    :root {
        --body-copy: "ROM-Regular", var(--system-ui);
        --body-strong: "ROM-Bold", var(--system-ui);
        --right: #3ecf8e;
        --wrong: #ff5c5c;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }
    html[data-new-ui-theme*="dark"] {
        --link: DarkOrange;
        --link-hover: DarkOrange;
        --border-focus: DarkOrange;
    }
    html {
        font-family: var(--body-copy);
        background-color: var(--background-high-contrast);
    }
    body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        font-family: var(--body-copy);
        min-height: 100vh;
        color: var(--content-primary);
        background: var(--background-high-contrast);
    }
    a {
        color: inherit;
    }
    h1, h2, h3 {
        font-family: var(--body-strong);
        font-weight: 500;
    }
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        padding: 8px 16px;
        background: var(--background);
        color: var(--link);
        z-index: 9999;
    }
    .skip-link:focus {
        top: 8px;
    }
    .site-footer {
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }
    .site-footer a {
        color: var(--content-secondary);
        text-decoration: none;
    }
    .site-footer a:hover {
        color: var(--link);
    }
    .install-cta {
        position: fixed;
        inset-inline: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border: 1px solid var(--grey8);
        border-radius: 14px;
        background: var(--grey10);
        color: var(--content-primary);
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
        animation: install-cta-in 0.3s ease-out;
    }
    .install-cta[hidden] {
        display: none;
    }
    .install-cta img {
        flex: none;
        border-radius: 10px;
    }
    .install-cta-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.8rem;
        color: var(--content-secondary);
    }
    .install-cta-text strong {
        font-family: var(--body-strong);
        font-size: 0.95rem;
        color: var(--content-primary);
    }
    .install-cta-btn {
        flex: none;
        padding: 8px 16px;
        border: 0;
        border-radius: 10px;
        background: DarkOrange;
        color: var(--black);
        font-family: var(--body-strong);
        font-size: 0.9rem;
        cursor: pointer;
    }
    .install-cta-close {
        flex: none;
        align-self: flex-start;
        padding: 0 4px;
        border: 0;
        background: none;
        color: var(--content-secondary);
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
    }
    :is(.install-cta-btn, .install-cta-close):focus-visible {
        outline: 2px solid DarkOrange;
        outline-offset: 2px;
    }
    @keyframes install-cta-in {
        from { transform: translateY(120%); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
        .install-cta { animation: none; }
    }
</style>
