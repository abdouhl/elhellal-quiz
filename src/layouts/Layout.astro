---
import "@new-ui/foundations";
import { DEFAULT_LANG, LANGS, base, t } from "../i18n";
import type { Lang } from "../i18n";
import { SITE } from "../game/seo";
import type { Alternates } from "../game/seo";

export interface Props {
    lang: Lang;
    pageTitle: string;
    pageDescription: string;
    canonicalUrl?: string;
    ogImage?: string;
    noindex?: boolean;
    /** This page in each language that has it; defaults to each language's home page. */
    alternates?: Alternates;
}

const { lang, pageTitle, pageDescription, canonicalUrl, ogImage, noindex } = Astro.props;
const alternates: Alternates = Astro.props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, `${base(l)}/`]));
const s = t(lang);
const others = LANGS.filter((l) => l !== lang);
/** iOS launch screens (built by scripts/build-splash.ts): portrait width × height in pixels, and pixel ratio. */
const SPLASH: [number, number, number][] = [
    [1320, 2868, 3], [1206, 2622, 3], [1290, 2796, 3], [1179, 2556, 3], [1284, 2778, 3], [1170, 2532, 3],
    [1125, 2436, 3], [1242, 2688, 3], [828, 1792, 2], [1242, 2208, 3], [750, 1334, 2], [640, 1136, 2],
    [2048, 2732, 2], [1668, 2388, 2], [1640, 2360, 2], [1620, 2160, 2], [1536, 2048, 2],
];
---

<!doctype html>
<html lang={lang} dir={s.dir} data-new-ui-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    {SPLASH.map(([w, h, r]) => (
        <link rel="apple-touch-startup-image" href={`/splash/${w}x${h}.png`} media={`(device-width: ${w / r}px) and (device-height: ${h / r}px) and (-webkit-device-pixel-ratio: ${r}) and (orientation: portrait)`} />
    ))}
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href={`${base(lang)}/manifest.webmanifest`} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content={s.siteName} />
    <link rel="preload" href="/woffs/ROM-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/woffs/ROM-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && Object.entries(alternates).map(([l, path]) => <link rel="alternate" hreflang={l} href={`${SITE}${path}`} />)}
    {!noindex && alternates[DEFAULT_LANG] && <link rel="alternate" hreflang="x-default" href={`${SITE}${alternates[DEFAULT_LANG]}`} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={s.ogLocale} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abdou_hll" />
    <!-- Google AdSense (same publisher account as elhellal.com) -->
    <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3610150616518651"
        crossorigin="anonymous"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">{s.skip}</a>

    <slot />

    <footer class="site-footer">
        <a href={`${base(lang)}/daily/`}>{s.footerDaily}</a>
        <a href={`${base(lang)}/c/`}>{s.footerAll}</a>
        {others.map((l) => (
            <a href={alternates[l] ?? `${base(l)}/`} hreflang={l} lang={l} data-lang-choice={l}>{t(l).langName}</a>
        ))}
        <a href="https://elhellal.com">{s.footerHome}</a>
    </footer>

    <!-- Offered once to visitors whose location or browser suggests the other language (see the script below). -->
    {others.map((l) => (
        <div class="lang-cta" data-lang-cta={l} lang={l} dir={t(l).dir} hidden>
            <span>{t(l).suggest}</span>
            <a class="install-cta-btn" href={alternates[l] ?? `${base(l)}/`} data-lang-choice={l}>{t(l).suggestYes}</a>
            <button type="button" class="install-cta-close" data-lang-stay aria-label={t(l).close}>×</button>
        </div>
    ))}

    <div class="app-note offline-chip" id="offline-chip" role="status" hidden>{s.offline}</div>
    <div class="lang-cta app-note" id="update-cta" role="status" hidden>
        <span>{s.updated}</span>
        <button type="button" class="install-cta-btn" id="update-btn">{s.reload}</button>
    </div>

    <div class="install-cta" id="install-cta" role="dialog" aria-labelledby="install-cta-title" hidden>
        <img src="/icon-192.png" alt="" width="40" height="40" />
        <div class="install-cta-text">
            <strong id="install-cta-title">{s.installTitle}</strong>
            <span id="install-cta-desc" data-ios={s.installIos}>{s.installDesc}</span>
        </div>
        <button type="button" class="install-cta-btn" id="install-cta-btn">{s.install}</button>
        <button type="button" class="install-cta-close" id="install-cta-close" aria-label={s.close}>×</button>
    </div>

    <script is:inline>
        if ("serviceWorker" in navigator) {
            // A page that was already controlled gets a newer worker mid-visit: offer to reload onto it.
            // (The first install also changes controller, which isn't an update.)
            const updating = !!navigator.serviceWorker.controller;
            navigator.serviceWorker.addEventListener("controllerchange", () => {
                if (!updating) return;
                const cta = document.getElementById("update-cta");
                cta.hidden = false;
                document.getElementById("update-btn").addEventListener("click", () => location.reload());
            });
            addEventListener("load", () => {
                navigator.serviceWorker.register("/sw.js");
                navigator.serviceWorker.ready.then(async (r) => {
                    // save every question picture for offline play, unless the visitor asked to save data
                    if (!navigator.connection?.saveData) r.active?.postMessage("cache-pics");
                    // installed app: let the worker wake up now and then to put the daily dot on the icon
                    try {
                        if (!r.periodicSync || !matchMedia("(display-mode: standalone)").matches) return;
                        const { state } = await navigator.permissions.query({ name: "periodic-background-sync" });
                        if (state === "granted") await r.periodicSync.register("daily", { minInterval: 6 * 60 * 60 * 1000 });
                    } catch {}
                });
            });
        }

        // Offline: say so, and hide what needs the network ([data-online]).
        (() => {
            const chip = document.getElementById("offline-chip");
            const sync = () => {
                chip.hidden = navigator.onLine;
                document.documentElement.classList.toggle("is-offline", !navigator.onLine);
            };
            addEventListener("online", sync);
            addEventListener("offline", sync);
            sync();
        })();

        (() => {
            const KEY = "install-cta-dismissed";
            const SNOOZE_MS = 7 * 24 * 60 * 60 * 1000;
            const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
            const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
                (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
            if (standalone || !mobile) return;
            try {
                if (Date.now() - Number(localStorage.getItem(KEY) || 0) < SNOOZE_MS) return;
            } catch {}

            // At a good moment: right after a streak of 5 or a finished daily challenge ("quiz:moment"),
            // once the visitor has played a little; failing that, after plenty of answers.
            const answered = () => {
                try {
                    return Number(localStorage.getItem("quiz.answered")) || 0;
                } catch {
                    return 0;
                }
            };
            const whenEngaged = (fn) => {
                let done = false;
                const go = () => {
                    if (done) return;
                    done = true;
                    removeEventListener("quiz:moment", onMoment);
                    removeEventListener("quiz:answered", onAnswer);
                    fn();
                };
                const onMoment = () => answered() >= 5 && go();
                const onAnswer = () => answered() >= 40 && go();
                addEventListener("quiz:moment", onMoment);
                addEventListener("quiz:answered", onAnswer);
            };

            const cta = document.getElementById("install-cta");
            const btn = document.getElementById("install-cta-btn");
            const desc = document.getElementById("install-cta-desc");
            const hide = (remember) => {
                cta.hidden = true;
                if (remember) try { localStorage.setItem(KEY, String(Date.now())); } catch {}
            };
            document.getElementById("install-cta-close").addEventListener("click", () => hide(true));

            const ios = /iPhone|iPad|iPod/i.test(navigator.userAgent) || navigator.maxTouchPoints > 1 && navigator.platform === "MacIntel";
            if (ios) {
                // iOS has no install prompt API: show manual instructions instead.
                desc.textContent = desc.dataset.ios;
                btn.hidden = true;
                whenEngaged(() => setTimeout(() => (cta.hidden = false), 1500));
                return;
            }

            let deferred;
            addEventListener("beforeinstallprompt", (e) => {
                e.preventDefault();
                deferred = e;
                whenEngaged(() => deferred && (cta.hidden = false));
            });
            btn.addEventListener("click", async () => {
                if (!deferred) return;
                deferred.prompt();
                const { outcome } = await deferred.userChoice;
                deferred = null;
                hide(outcome !== "accepted");
            });
            addEventListener("appinstalled", () => hide(false));
        })();

        // Language: never switch on our own; offer the other language once to visitors whose country
        // (from Cloudflare) and browser both point to it, and remember what they pick.
        (() => {
            const KEY = "lang.choice";
            const lang = document.documentElement.lang;
            const remember = (l) => {
                try { localStorage.setItem(KEY, l); } catch {}
            };
            document.querySelectorAll("[data-lang-choice]").forEach((a) => a.addEventListener("click", () => remember(a.dataset.langChoice)));
            try {
                if (localStorage.getItem(KEY)) return;
            } catch {
                return;
            }
            const COUNTRIES = {
                ar: "dz ma tn ly eg sd mr so dj km sa ae qa bh kw om ye iq sy jo lb ps".split(" "),
                es: "es mx ar co pe ve cl ec gt cu bo do hn py sv ni cr pa uy pr gq".split(" "),
            };
            const browser = (code) => (navigator.languages || [navigator.language]).some((l) => new RegExp(`^${code}\\b`, "i").test(l));
            fetch("/api/geo")
                .then((r) => (r.ok ? r.json() : {}))
                .then(({ country }) => {
                    const c = String(country || "").toLowerCase();
                    const fits = (code) => COUNTRIES[code].includes(c) || browser(code);
                    // Arabic first, then Spanish; otherwise English, or — country unknown — stay put.
                    const want = fits("ar") ? "ar" : fits("es") ? "es" : country ? "en" : lang;
                    if (want === lang) return;
                    const cta = document.querySelector(`[data-lang-cta="${want}"]`);
                    if (!cta) return;
                    cta.hidden = false;
                    cta.querySelector("[data-lang-stay]").addEventListener("click", () => {
                        cta.hidden = true;
                        remember(lang);
                    });
                })
                .catch(() => {});
        })();
    </script>
</body>
</html>

<style is:global>
    @font-face {
        font-family: "ROM-Regular";
        src: url("/woffs/ROM-Regular.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Bold";
        src: url("/woffs/ROM-Bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
    }
    :root {
        --body-copy: "ROM-Regular", var(--system-ui);
        --body-strong: "ROM-Bold", var(--system-ui);
        --right: #3ecf8e;
        --wrong: #ff5c5c;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }
    html[data-new-ui-theme*="dark"] {
        --link: DarkOrange;
        --link-hover: DarkOrange;
        --border-focus: DarkOrange;
    }
    html {
        font-family: var(--body-copy);
        background-color: var(--background-high-contrast);
    }
    body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        font-family: var(--body-copy);
        min-height: 100vh;
        color: var(--content-primary);
        background: var(--background-high-contrast);
    }
    a {
        color: inherit;
    }
    h1, h2, h3 {
        font-family: var(--body-strong);
        font-weight: 500;
    }
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        padding: 8px 16px;
        background: var(--background);
        color: var(--link);
        z-index: 9999;
    }
    .skip-link:focus {
        top: 8px;
    }
    .site-footer {
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }
    .site-footer a {
        color: var(--content-secondary);
        text-decoration: none;
    }
    .site-footer a:hover {
        color: var(--link);
    }
    .install-cta {
        position: fixed;
        inset-inline: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border: 1px solid var(--grey8);
        border-radius: 14px;
        background: var(--grey10);
        color: var(--content-primary);
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
        animation: install-cta-in 0.3s ease-out;
    }
    .install-cta[hidden], .lang-cta[hidden], .app-note[hidden] {
        display: none;
    }
    .is-offline [data-online] {
        display: none;
    }
    .offline-chip {
        position: fixed;
        top: calc(8px + env(safe-area-inset-top));
        left: 50%;
        transform: translateX(-50%);
        z-index: 1001;
        padding: 4px 12px;
        border: 1px solid var(--grey8);
        border-radius: 999px;
        background: var(--grey10);
        color: var(--content-secondary);
        font-size: 0.8rem;
        pointer-events: none;
    }
    .offline-chip::before {
        content: "";
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-inline-end: 6px;
        border-radius: 50%;
        background: var(--wrong);
        vertical-align: middle;
    }
    .lang-cta {
        position: fixed;
        inset-inline: 12px;
        top: calc(12px + env(safe-area-inset-top));
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--grey8);
        border-radius: 14px;
        background: var(--grey10);
        color: var(--content-primary);
        font-size: 0.9rem;
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
    }
    .lang-cta span {
        flex: 1;
    }
    .lang-cta a {
        text-decoration: none;
    }
    .install-cta img {
        flex: none;
        border-radius: 10px;
    }
    .install-cta-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.8rem;
        color: var(--content-secondary);
    }
    .install-cta-text strong {
        font-family: var(--body-strong);
        font-size: 0.95rem;
        color: var(--content-primary);
    }
    .install-cta-btn {
        flex: none;
        padding: 8px 16px;
        border: 0;
        border-radius: 10px;
        background: DarkOrange;
        color: var(--black);
        font-family: var(--body-strong);
        font-size: 0.9rem;
        cursor: pointer;
    }
    .install-cta-close {
        flex: none;
        align-self: flex-start;
        padding: 0 4px;
        border: 0;
        background: none;
        color: var(--content-secondary);
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
    }
    :is(.install-cta-btn, .install-cta-close):focus-visible {
        outline: 2px solid DarkOrange;
        outline-offset: 2px;
    }
    @keyframes install-cta-in {
        from { transform: translateY(120%); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
        .install-cta { animation: none; }
    }
</style>
