---
import "@new-ui/foundations";

export interface Props {
    pageTitle: string;
    pageDescription: string;
    canonicalUrl?: string;
    ogImage?: string;
}

const { pageTitle, pageDescription, canonicalUrl, ogImage } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" data-new-ui-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/woffs/ROM-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/woffs/ROM-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abdou_hll" />
    <!-- Google AdSense (same publisher account as elhellal.com) -->
    <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3610150616518651"
        crossorigin="anonymous"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">التخطي إلى المحتوى الرئيسي</a>

    <header class="site-header" aria-label="رأس الصفحة">
        <div class="site-header-inner">
            <a href="/" class="brand-link" aria-label="الصفحة الرئيسية">
                <img src="/xarticles.svg" width="36" height="36" alt="" aria-hidden="true" />
                <span class="brand-name">اختبار الهلال</span>
            </a>
            <nav class="site-nav" aria-label="روابط الموقع">
                <a href="https://elhellal.com" rel="noopener">المقالات</a>
                <a href="https://books.elhellal.com" rel="noopener">ملخصات الكتب</a>
            </nav>
        </div>
    </header>

    <slot />

    <footer class="site-footer">
        <p>
            جزء من <a href="https://elhellal.com">الهلال</a> — مقالات وكتب واقتباسات عربية مختارة.
        </p>
    </footer>
</body>
</html>

<style is:global>
    @font-face {
        font-family: "ROM-Regular";
        src: url("/woffs/ROM-Regular.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Bold";
        src: url("/woffs/ROM-Bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
    }
    :root {
        --body-copy: "ROM-Regular", var(--system-ui);
        --body-strong: "ROM-Bold", var(--system-ui);
        --right: #3ecf8e;
        --wrong: #ff5c5c;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }
    html[data-new-ui-theme*="dark"] {
        --link: DarkOrange;
        --link-hover: DarkOrange;
        --border-focus: DarkOrange;
    }
    html {
        font-family: var(--body-copy);
        background-color: var(--background-high-contrast);
    }
    body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        font-family: var(--body-copy);
        color: var(--content-primary);
        background-color: var(--background-high-contrast);
    }
    a {
        color: inherit;
    }
    h1, h2, h3 {
        font-family: var(--body-strong);
        font-weight: 500;
    }
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        padding: 8px 16px;
        background: var(--background-high-contrast);
        z-index: 9999;
    }
    .skip-link:focus {
        top: 8px;
    }
    .site-header {
        border-bottom: 0.5px solid var(--border-muted);
    }
    .site-header-inner {
        max-width: 760px;
        margin: 0 auto;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }
    .brand-name {
        font-family: var(--body-strong);
        font-size: 1.4rem;
    }
    .site-nav {
        display: flex;
        gap: 16px;
        font-size: 0.9rem;
    }
    .site-nav a {
        color: var(--content-secondary);
        text-decoration: none;
    }
    .site-nav a:hover {
        color: var(--link);
    }
    .site-footer {
        max-width: 760px;
        margin: 40px auto 0;
        padding: 24px 16px 40px;
        border-top: 0.5px solid var(--border-muted);
        color: var(--content-secondary);
        font-size: 0.9rem;
        text-align: center;
    }
    .site-footer a {
        text-decoration: underline;
    }
</style>
