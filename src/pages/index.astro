---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, CATEGORY_LABELS } from "../game/engine";
---

<Layout
    pageTitle="اختبار الهلال — أسئلة لا تنتهي بالعربية"
    pageDescription="اختبار عربي لا ينتهي: أسئلة ثقافة عامة وجغرافيا وعلوم وتاريخ وأدب، ولعبة «من قال؟» من اقتباسات الكتّاب العرب. العب بلا حدود وحطّم رقمك القياسي."
    canonicalUrl="https://quiz.elhellal.com/"
>
    <main id="main-content" class="quiz">
        <div class="controls">
            <div class="chips" role="group" aria-label="اختر الفئة">
                <button type="button" class="chip" data-cat="all" aria-pressed="true">الكل</button>
                {CATEGORIES.map((c) => (
                    <button type="button" class="chip" data-cat={c} aria-pressed="false">{CATEGORY_LABELS[c]}</button>
                ))}
            </div>
            <div class="modes" role="group" aria-label="نمط اللعب">
                <button type="button" class="mode" data-mode="challenge" aria-pressed="true">تحدّي · ٣ أرواح</button>
                <button type="button" class="mode" data-mode="practice" aria-pressed="false">تدريب · بلا نهاية</button>
            </div>
        </div>

        <div class="hud" aria-label="النتيجة">
            <div class="stat"><span class="stat-label">النقاط</span><span id="score" class="stat-value">0</span></div>
            <div class="stat"><span class="stat-label">التتابع</span><span id="streak" class="stat-value">0</span></div>
            <div class="stat"><span class="stat-label">الأفضل</span><span id="best" class="stat-value">0</span></div>
            <div class="stat" id="lives-wrap"><span class="stat-label">الأرواح</span><span id="lives" class="stat-value" aria-live="polite">♥♥♥</span></div>
        </div>

        <section id="card" class="card" aria-live="polite">
            <p id="q-cat" class="q-cat"></p>
            <h2 id="q-text" class="q-text">جارٍ التحميل…</h2>
            <div id="opts" class="opts"></div>
            <div class="foot">
                <p id="feedback" class="feedback" role="status"></p>
                <button type="button" id="next" class="next" hidden>التالي ←</button>
            </div>
        </section>

        <section id="over" class="card over" hidden>
            <h2>انتهت اللعبة</h2>
            <p class="over-score"><span id="over-score">0</span> نقطة</p>
            <p id="over-detail" class="over-detail"></p>
            <div class="over-actions">
                <button type="button" id="again" class="next">العب مجدداً</button>
                <button type="button" id="share" class="ghost">شارك نتيجتك</button>
            </div>
            <p id="share-note" class="share-note" role="status"></p>
        </section>

        <noscript><p class="noscript">هذه اللعبة تحتاج إلى تفعيل جافاسكربت.</p></noscript>

        <section class="about">
            <h2>كيف تلعب؟</h2>
            <p>
                اختر الإجابة الصحيحة من أربعة خيارات. في نمط «التحدّي» تبدأ بثلاثة أرواح وتخسر روحاً مع كل إجابة خاطئة،
                وفي نمط «التدريب» تلعب بلا حدود. كل إجابة صحيحة متتالية تزيد نقاطك. الأسئلة لا تنتهي:
                جغرافيا، علوم، تاريخ، لغة عربية، أدب وكتب، ولعبة «من قال؟» من اقتباسات كتّاب عرب مثل غسان كنفاني ونجيب محفوظ وأحلام مستغانمي.
            </p>
            <p class="kbd-hint">اختصارات: اضغط ١ – ٤ للإجابة، وEnter للسؤال التالي.</p>
        </section>
    </main>

    <script>
        import { CATEGORY_LABELS, createDeck, pointsFor } from "../game/engine";
        import type { CategoryFilter, Question } from "../game/engine";

        type Mode = "challenge" | "practice";
        const MAX_LIVES = 3;
        const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

        const el = {
            score: $("score"),
            streak: $("streak"),
            best: $("best"),
            lives: $("lives"),
            livesWrap: $("lives-wrap"),
            card: $("card"),
            qCat: $("q-cat"),
            qText: $("q-text"),
            opts: $("opts"),
            feedback: $("feedback"),
            next: $<HTMLButtonElement>("next"),
            over: $("over"),
            overScore: $("over-score"),
            overDetail: $("over-detail"),
            again: $<HTMLButtonElement>("again"),
            share: $<HTMLButtonElement>("share"),
            shareNote: $("share-note"),
        };

        // localStorage can throw (private windows, blocked storage) — the game must work without it.
        const store = {
            get(key: string): string | null {
                try {
                    return localStorage.getItem(key);
                } catch {
                    return null;
                }
            },
            set(key: string, value: string) {
                try {
                    localStorage.setItem(key, value);
                } catch {}
            },
        };

        const AR_DIGITS = "٠١٢٣٤٥٦٧٨٩";
        const ar = (n: number) => String(n).replace(/\d/g, (d) => AR_DIGITS[+d]);

        let mode: Mode = store.get("quiz.mode") === "practice" ? "practice" : "challenge";
        let filter: CategoryFilter = "all";
        let deck = createDeck(filter);

        let score = 0;
        let streak = 0;
        let lives = MAX_LIVES;
        let answered = 0;
        let correct = 0;
        let bestStreak = 0;
        let question: Question | null = null;
        let locked = false;
        let advanceTimer: number | undefined;

        const bestKey = () => `quiz.best.${mode}`;
        const getBest = () => Number(store.get(bestKey())) || 0;

        function renderHud() {
            el.score.textContent = ar(score);
            el.streak.textContent = ar(streak);
            el.best.textContent = ar(Math.max(getBest(), mode === "challenge" ? score : 0));
            el.livesWrap.hidden = mode !== "challenge";
            el.lives.textContent = "♥".repeat(lives) + "♡".repeat(MAX_LIVES - lives);
            el.lives.setAttribute("aria-label", `${lives} من ${MAX_LIVES} أرواح`);
        }

        function renderQuestion(q: Question) {
            question = q;
            locked = false;
            el.qCat.textContent = CATEGORY_LABELS[q.category];
            el.qText.textContent = q.text;
            el.qText.classList.toggle("is-quote", q.isQuote);
            el.opts.replaceChildren(
                ...q.options.map((text, i) => {
                    const b = document.createElement("button");
                    b.type = "button";
                    b.className = "opt";
                    b.dataset.i = String(i);
                    const num = document.createElement("span");
                    num.className = "opt-num";
                    num.textContent = ar(i + 1);
                    const label = document.createElement("span");
                    label.textContent = text;
                    b.append(num, label);
                    return b;
                }),
            );
            el.feedback.textContent = "";
            el.feedback.className = "feedback";
            el.next.hidden = true;
        }

        function nextQuestion() {
            clearTimeout(advanceTimer);
            renderQuestion(deck.next());
        }

        function answer(i: number) {
            if (locked || !question) return;
            locked = true;
            const q = question;
            const buttons = [...el.opts.querySelectorAll<HTMLButtonElement>(".opt")];
            buttons.forEach((b) => (b.disabled = true));
            buttons[q.answer].classList.add("right");
            answered++;

            if (i === q.answer) {
                correct++;
                streak++;
                bestStreak = Math.max(bestStreak, streak);
                score += pointsFor(streak);
                el.feedback.textContent = streak >= 3 ? `إجابة صحيحة! 🔥 ${ar(streak)} متتالية` : "إجابة صحيحة!";
                el.feedback.className = "feedback ok";
                renderHud();
                advanceTimer = window.setTimeout(nextQuestion, 900);
                return;
            }

            buttons[i].classList.add("wrong");
            streak = 0;
            el.feedback.textContent = `الإجابة الصحيحة: ${q.options[q.answer]}`;
            el.feedback.className = "feedback bad";
            if (mode === "challenge") lives--;
            renderHud();

            if (mode === "challenge" && lives === 0) {
                el.next.textContent = "النتيجة ←";
                el.next.hidden = false;
                el.next.focus();
                el.next.dataset.end = "1";
                return;
            }
            el.next.textContent = "التالي ←";
            delete el.next.dataset.end;
            el.next.hidden = false;
            el.next.focus();
        }

        function gameOver() {
            const prev = getBest();
            const isRecord = mode === "challenge" && score > prev;
            if (isRecord) store.set(bestKey(), String(score));
            el.card.hidden = true;
            el.over.hidden = false;
            el.overScore.textContent = ar(score);
            const acc = answered ? Math.round((correct / answered) * 100) : 0;
            el.overDetail.textContent =
                `${ar(correct)} من ${ar(answered)} صحيحة (${ar(acc)}٪) · أطول تتابع ${ar(bestStreak)}` +
                (isRecord ? " · 🏆 رقم قياسي جديد!" : "");
            el.shareNote.textContent = "";
            el.again.focus();
        }

        function reset() {
            clearTimeout(advanceTimer);
            score = streak = answered = correct = bestStreak = 0;
            lives = MAX_LIVES;
            deck = createDeck(filter);
            el.over.hidden = true;
            el.card.hidden = false;
            renderHud();
            nextQuestion();
        }

        el.opts.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".opt");
            if (b) answer(Number(b.dataset.i));
        });

        el.next.addEventListener("click", () => {
            if (el.next.dataset.end) gameOver();
            else nextQuestion();
        });
        el.again.addEventListener("click", reset);

        el.share.addEventListener("click", async () => {
            const text = `حصلت على ${ar(score)} نقطة في اختبار الهلال 🎯 هل تتفوق عليّ؟\nhttps://quiz.elhellal.com`;
            try {
                if (navigator.share) {
                    await navigator.share({ text });
                } else {
                    await navigator.clipboard.writeText(text);
                    el.shareNote.textContent = "تم نسخ النتيجة ✓";
                }
            } catch {
                // user dismissed the share sheet, or clipboard blocked
            }
        });

        function syncPressed(selector: string, attr: "cat" | "mode", value: string) {
            document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
                b.setAttribute("aria-pressed", String(b.dataset[attr] === value));
            });
        }

        document.querySelectorAll<HTMLButtonElement>(".chip").forEach((b) =>
            b.addEventListener("click", () => {
                filter = b.dataset.cat as CategoryFilter;
                syncPressed(".chip", "cat", filter);
                reset();
            }),
        );
        document.querySelectorAll<HTMLButtonElement>(".mode").forEach((b) =>
            b.addEventListener("click", () => {
                mode = b.dataset.mode as Mode;
                store.set("quiz.mode", mode);
                syncPressed(".mode", "mode", mode);
                reset();
            }),
        );

        document.addEventListener("keydown", (e) => {
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            const n = e.key.length === 1 ? "1234".indexOf(e.key) : -1;
            const arN = e.key.length === 1 ? "١٢٣٤".indexOf(e.key) : -1;
            if ((n >= 0 || arN >= 0) && !el.card.hidden) answer(n >= 0 ? n : arN);
            else if (e.key === "Enter" && !el.next.hidden && document.activeElement !== el.next) el.next.click();
        });

        syncPressed(".mode", "mode", mode);
        reset();
    </script>
</Layout>

<style is:global>
    .quiz {
        max-width: 760px;
        margin: 0 auto;
        padding: 20px 16px 0;
    }
    .controls {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .chips, .modes {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .chip, .mode, .ghost {
        font: inherit;
        font-size: 0.9rem;
        padding: 6px 14px;
        border-radius: 999px;
        border: 0.5px solid var(--border-strong);
        background: transparent;
        color: var(--content-secondary);
        cursor: pointer;
    }
    .chip[aria-pressed="true"], .mode[aria-pressed="true"] {
        background: var(--link);
        border-color: var(--link);
        color: #000;
    }
    .chip:hover:not([aria-pressed="true"]), .mode:hover:not([aria-pressed="true"]), .ghost:hover {
        border-color: var(--link);
        color: var(--content-primary);
    }
    .hud {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin: 20px 0 12px;
    }
    .stat {
        border: 0.5px solid var(--border-muted);
        border-radius: 10px;
        padding: 8px 10px;
        text-align: center;
    }
    .stat[hidden] {
        display: none;
    }
    .hud:has(#lives-wrap[hidden]) {
        grid-template-columns: repeat(3, 1fr);
    }
    .stat-label {
        display: block;
        font-size: 0.75rem;
        color: var(--content-secondary);
    }
    .stat-value {
        font-family: var(--body-strong);
        font-size: 1.3rem;
        color: var(--content-primary);
    }
    #lives {
        color: var(--wrong);
        letter-spacing: 2px;
    }
    .card {
        border: 0.5px solid var(--border-strong);
        border-radius: 16px;
        padding: 20px;
        background: var(--background);
    }
    .card[hidden] {
        display: none;
    }
    .q-cat {
        margin: 0 0 8px;
        font-size: 0.8rem;
        color: var(--link);
    }
    .q-text {
        margin: 0 0 20px;
        font-size: 1.4rem;
        line-height: 1.7;
        min-height: 3.4em;
    }
    .q-text.is-quote {
        font-size: 1.15rem;
        border-inline-start: 3px solid var(--link);
        padding-inline-start: 14px;
        color: var(--content-primary);
    }
    .opts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .opt {
        font: inherit;
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: start;
        padding: 14px;
        border-radius: 12px;
        border: 0.5px solid var(--border-strong);
        background: var(--background-secondary, transparent);
        color: var(--content-primary);
        cursor: pointer;
        line-height: 1.5;
    }
    .opt:hover:not(:disabled) {
        border-color: var(--link);
    }
    .opt:disabled {
        cursor: default;
        color: var(--content-secondary);
    }
    .opt.right {
        border-color: var(--right);
        background: color-mix(in srgb, var(--right) 18%, transparent);
        color: var(--content-primary);
    }
    .opt.wrong {
        border-color: var(--wrong);
        background: color-mix(in srgb, var(--wrong) 18%, transparent);
        color: var(--content-primary);
    }
    .opt-num {
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 0.5px solid var(--border-strong);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        color: var(--content-secondary);
    }
    .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 44px;
        margin-top: 16px;
    }
    .feedback {
        margin: 0;
        font-size: 0.95rem;
    }
    .feedback.ok { color: var(--right); }
    .feedback.bad { color: var(--wrong); }
    .next {
        font: inherit;
        padding: 10px 22px;
        border-radius: 999px;
        border: none;
        background: var(--link);
        color: #000;
        cursor: pointer;
    }
    .next[hidden] {
        display: none;
    }
    .over {
        text-align: center;
    }
    .over-score {
        font-family: var(--body-strong);
        font-size: 2.6rem;
        margin: 8px 0;
    }
    .over-detail {
        color: var(--content-secondary);
    }
    .over-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }
    .ghost {
        padding: 10px 22px;
    }
    .share-note {
        min-height: 1.4em;
        color: var(--right);
        font-size: 0.9rem;
    }
    .about {
        margin-top: 32px;
        color: var(--content-secondary);
        line-height: 1.9;
    }
    .about h2 {
        font-size: 1.1rem;
        color: var(--content-primary);
    }
    .kbd-hint {
        font-size: 0.85rem;
    }
    .noscript {
        text-align: center;
        color: var(--wrong);
    }
    :is(.chip, .mode, .opt, .next, .ghost):focus-visible {
        outline: 2px solid var(--border-focus);
        outline-offset: 2px;
    }
    @media (max-width: 560px) {
        .opts {
            grid-template-columns: 1fr;
        }
        .q-text {
            font-size: 1.2rem;
        }
        .hud {
            gap: 6px;
        }
    }
</style>
