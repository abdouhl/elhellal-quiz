---
import HubPage from "../../views/HubPage.astro";
import type { Category } from "../../game/engine";
import { categories } from "../../game/seo";

export function getStaticPaths() {
    return categories("ar").map((category) => ({ params: { category } }));
}
---

<HubPage lang="ar" category={Astro.params.category as Category} />
