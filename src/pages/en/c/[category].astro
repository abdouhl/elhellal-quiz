---
import HubPage from "../../../views/HubPage.astro";
import type { Category } from "../../../game/engine";
import { categories } from "../../../game/seo";

export function getStaticPaths() {
    return categories("en").map((category) => ({ params: { category } }));
}
---

<HubPage lang="en" category={Astro.params.category as Category} />
