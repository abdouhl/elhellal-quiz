---
// The lobby, as in the iOS app (Hellal/UI/HomeView.swift): the player's rank and rating, the big play
// button, today's challenge with the week's streak, the game modes and the categories.
// Rendered with neutral values; the script fills in what this browser has saved.
import { CATEGORY_ICONS } from "../game/engine";
import { categories } from "../game/seo";
import { base, t } from "../i18n";
import type { Lang } from "../i18n";
import "../styles/quiz.css";

export interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const play = `${base(lang)}/play/`;
const cats = categories(lang);
---

<main id="main-content" class="app lobby">
    <header class="hud">
        <h1 class="brand"><img src="/favicon.svg" alt="" width="34" height="34" />{s.siteName}</h1>
        <span class="hud-end">
            <a id="h-days" class="pill" href={`${base(lang)}/daily/`} title={s.dailyStreakTitle}>🔥 <b>{s.n(0)}</b></a>
            <span id="h-best" class="pill" title={s.bestTitle}>★ <b>{s.n(0)}</b></span>
        </span>
    </header>

    <section id="rank" class="rank" aria-live="polite">
        <svg class="shield" viewBox="0 0 64 72" aria-hidden="true">
            <defs>
                <linearGradient id="shield-g" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" style="stop-color: var(--r1)"></stop>
                    <stop offset="1" style="stop-color: var(--r2)"></stop>
                </linearGradient>
            </defs>
            <path d="M32 2 60 11v23c0 18-12 30-28 36C16 64 4 52 4 34V11Z" fill="url(#shield-g)"></path>
            <path d="M32 8 54 15v19c0 14-9 24-22 30C19 58 10 48 10 34V15Z" fill="rgb(255 255 255 / 0.18)"></path>
            <path d="M32 22 42 34 32 46 22 34Z" fill="#fff"></path>
        </svg>
        <div class="rank-body">
            <p id="r-name" class="rank-name">{s.ranks[0]}</p>
            <p class="rank-num"><b id="r-num">{s.n(1000)}</b> <span>{s.rating}</span></p>
            <div class="gbar"><span id="r-bar"></span></div>
            <p id="r-next" class="rank-next">{s.toNext(100, s.ranks[1])}</p>
        </div>
    </section>

    <a class="big-play" href={play}>
        <span class="big-play-label"><span aria-hidden="true">▶</span> {s.play}</span>
        <small>{s.playHint}</small>
    </a>

    <section class="dcard">
        <div class="dcard-head">
            <div>
                <h2 id="d-title">{s.dailyChip}</h2>
                <p id="d-sub">{s.dailyHint}</p>
                <p id="d-grid" class="d-grid" hidden></p>
            </div>
            <span class="dcard-cal" aria-hidden="true">📅</span>
        </div>
        <ol id="week" class="week" aria-label={s.dailyStreakTitle}></ol>
        <div id="rescue" class="rescue-row" hidden>
            <p id="rescue-text"></p>
            <button type="button" id="rescue-go" class="chunky chunky-cyan chunky-sm">{s.watchAd}</button>
        </div>
        <a id="d-go" class="dcard-go" href={`${base(lang)}/daily/`}>{s.dailyGo}</a>
    </section>

    <h2 class="lobby-h">{s.modes}</h2>
    <div class="tiles">
        <a class="tile tile-orange" href={`${play}?mode=blitz`}>
            <span class="tile-ico" aria-hidden="true">⚡</span>
            <b>{s.blitz}</b>
            <small id="t-blitz">{s.bestN(0)}</small>
        </a>
        <a class="tile tile-red" href={`${play}?mode=survival`}>
            <span class="tile-ico" aria-hidden="true">❤️</span>
            <b>{s.survival}</b>
            <small id="t-survival">{s.bestN(0)}</small>
        </a>
        <a id="t-review" class="tile tile-teal" href={`${play}?review`}>
            <span class="tile-ico" aria-hidden="true">↺</span>
            <b>{s.practice}</b>
            <span id="t-missed" class="tile-badge" hidden></span>
        </a>
        <a class="tile tile-purple" href={`${play}?cat=order`}>
            <span class="tile-ico" aria-hidden="true">🔢</span>
            <b>{s.labels.order}</b>
        </a>
        <a class="tile tile-green" href={`${play}?cat=typed`}>
            <span class="tile-ico" aria-hidden="true">⌨️</span>
            <b>{s.labels.typed}</b>
        </a>
        <a class="tile tile-blue" href={`${base(lang)}/c/`}>
            <span class="tile-ico" aria-hidden="true">📚</span>
            <b>{s.allCategories}</b>
        </a>
    </div>

    <h2 class="lobby-h">{s.categories}</h2>
    <div class="cats">
        {cats.map((c) => <a class="cat" href={`${play}?cat=${c}`}><span aria-hidden="true">{CATEGORY_ICONS[c]}</span> {s.labels[c]}</a>)}
    </div>

    <p class="lobby-about">{s.homeDesc}</p>
</main>

<script>
    import { DAILY_SIZE, dayKey, dayNumber } from "../game/engine";
    import { breakBefore, offerReward } from "../game/ads";
    import { track } from "../game/track";
    import { DAILY_KEY, dailyStatus, home, missedIds, num, restorableDailyStreak, restoreDailyStreak, s, store, syncBadge, toast } from "../game/client";
    import { RANK_COLORS, RANK_FLOORS, bestOf, rankOf, rating } from "../game/rating";

    const $ = (id: string) => document.getElementById(id)!;

    // Old links to the endless quiz's mistake practice (/?review, the app shortcut) now go to the play page.
    if (new URLSearchParams(location.search).has("review")) location.replace(`${home}play/?review`);

    function renderRank() {
        const r = rating();
        const i = rankOf(r);
        const rank = $("rank");
        rank.style.setProperty("--r1", RANK_COLORS[i][0]);
        rank.style.setProperty("--r2", RANK_COLORS[i][1]);
        $("r-name").textContent = s.ranks[i];
        $("r-num").textContent = num(Math.round(r));
        const next = RANK_FLOORS[i + 1];
        const floor = RANK_FLOORS[i];
        // Bronze starts at 0, but its bar runs from the starting rating so a new player's isn't nearly full.
        const from = i === 0 ? 900 : floor;
        $("r-bar").style.width = `${next ? Math.max(4, Math.min(100, ((r - from) / (next - from)) * 100)) : 100}%`;
        $("r-next").textContent = next ? s.toNext(Math.ceil(next - r), s.ranks[i + 1]) : s.topRank;
    }

    function renderDaily() {
        const today = dayKey();
        $("d-title").textContent = s.dailyTitle(dayNumber(today));
        const { streak, doneToday } = dailyStatus();
        $("h-days").querySelector("b")!.textContent = num(streak);
        let hits: boolean[] = [];
        try {
            const st = JSON.parse(store.get(`${DAILY_KEY}.state`) ?? "");
            if (st.day === today && Array.isArray(st.hits)) hits = st.hits;
        } catch {}
        const done = doneToday || hits.length >= DAILY_SIZE;
        if (done) {
            $("d-sub").textContent = s.dailyDone;
            $("d-sub").classList.add("ok");
            const grid = $("d-grid");
            grid.textContent = hits.map((h) => (h ? "🟩" : "🟥")).join("");
            grid.hidden = !hits.length;
        }
        $("d-go").hidden = done;

        // The last seven days, today last: a day is lit when it falls inside the current streak.
        // The streak's days count back from the last day played (today, or yesterday while today is still to play).
        const played = new Set<string>();
        const last = store.get(`${DAILY_KEY}.last`);
        if (streak > 0 && last) {
            const [y, m, d] = last.split("-").map(Number);
            for (let i = 0; i < Math.min(streak, 7); i++) played.add(dayKey(new Date(y, m - 1, d - i)));
        }
        const fmt = new Intl.DateTimeFormat(document.documentElement.lang, { weekday: "narrow" });
        const days: HTMLLIElement[] = [];
        for (let back = 6; back >= 0; back--) {
            const d = new Date();
            d.setDate(d.getDate() - back);
            const li = document.createElement("li");
            li.classList.toggle("on", played.has(dayKey(d)));
            li.classList.toggle("today", back === 0);
            li.innerHTML = `<span></span><small>${fmt.format(d)}</small>`;
            days.push(li);
        }
        $("week").replaceChildren(...days);

        // A streak broken by one missed day can be won back with a rewarded ad, as on the daily page.
        const lost = restorableDailyStreak();
        if (lost) {
            offerReward("daily-streak", (watch) => {
                $("rescue-text").textContent = s.streakLost(lost);
                $("rescue").hidden = false;
                const go = $("rescue-go") as HTMLButtonElement;
                go.onclick = async () => {
                    go.disabled = true;
                    if (await watch()) {
                        restoreDailyStreak();
                        $("rescue").hidden = true;
                        toast(s.dailyBack(lost));
                        renderDaily();
                    } else go.disabled = false;
                };
            });
        }
    }

    function render() {
        renderRank();
        renderDaily();
        $("h-best").querySelector("b")!.textContent = num(Number(store.get("quiz.bestStreak")) || 0);
        $("t-blitz").textContent = s.bestN(bestOf("blitz"));
        $("t-survival").textContent = s.bestN(bestOf("survival"));
        const missed = missedIds().length;
        const badge = $("t-missed");
        badge.hidden = missed < 1;
        badge.textContent = num(missed);
        $("t-review").title = missed ? s.reviewTitle(missed) : s.reviewDone;
    }

    // Starting a game is a natural break: when one is due, the tap may show an interstitial first ("start").
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.lobby a[href*="/play/"]')) {
        a.addEventListener("click", () => track("lobby_play", { target: new URL(a.href).search || "endless" }));
        breakBefore(a, "start-game");
    }

    render();
    syncBadge();
    // Back from a game (bfcache) or another tab: show what changed.
    addEventListener("pageshow", (e) => e.persisted && render());
</script>
