---
import { CATEGORY_ICONS, CATEGORY_LABELS, questionById } from "../game/engine";
import "../styles/quiz.css";

export interface Props {
    /** Start on this fixed question (used by /q/[id]); otherwise start on a random one. */
    initialId?: string;
}

const { initialId } = Astro.props;
const initial = initialId ? questionById(initialId) : null;
---

<main id="main-content" class="app">
    <div class="topbar" aria-live="polite">
        <span id="streak" class="chip chip-n" title="إجابات صحيحة متتالية">🔥 …</span>
        <span id="best" class="chip" title="أفضل سلسلة">★ …</span>
        <span class="topbar-end">
            <button type="button" id="report" class="chip chip-btn chip-icon" title="الإبلاغ عن خطأ في هذا السؤال" aria-label="الإبلاغ عن خطأ في هذا السؤال">⚑</button>
        </span>
    </div>

    <section id="card" class="card">
        <p id="q-cat" class="q-cat">{initial && `${CATEGORY_ICONS[initial.category]} ${CATEGORY_LABELS[initial.category]}`}</p>
        <figure id="q-fig" class="q-fig" data-kind={initial?.category} hidden={!initial?.image}>
            <img src={initial?.image} alt="صورة السؤال" decoding="async" />
            <figcaption><a href={initial?.creditUrl || "#"} target="_blank" rel="noopener" hidden={!initial?.credit}>{initial?.credit && `📷 ${initial.credit}`}</a></figcaption>
        </figure>
        <h1 id="q-text" class:list={["q-text", { "is-quote": initial?.isQuote, "has-pic": initial?.image }]} data-id={initial ? initialId : undefined}>
            {initial ? initial.text : "جارٍ التحميل…"}
        </h1>
        <p id="q-claim" class="q-claim" hidden={!initial?.claim}>{initial?.claim && `«${initial.claim}»`}</p>
    </section>

    <div id="opts" class="opts" role="group" aria-label="الخيارات">
        {
            initial?.options.map((text, i) => (
                <button type="button" class="opt" data-i={i}>
                    {text}
                </button>
            ))
        }
    </div>

    <div class="foot">
        <p id="feedback" class="feedback" role="status"></p>
        <button type="button" id="brag" class="brag" hidden>شارك رقمك القياسي 🔥</button>
        <a id="next" class="next" href="/" hidden>التالي ←</a>
    </div>
    <p id="reveal" class="reveal"></p>
    <div id="auto" class="auto" aria-hidden="true"><span></span></div>

    <p class="hint">اضغط ١ – ٤ للإجابة، وأي مكان للمتابعة.</p>
    <noscript><p class="noscript">هذه اللعبة تحتاج إلى تفعيل جافاسكربت.</p></noscript>
</main>

<script>
    import { CATEGORY_ICONS, CATEGORY_LABELS, createDeck, questionById } from "../game/engine";
    import type { Question } from "../game/engine";
    import { SITE, ar, countAnswer, fetchRates, recordAnswer, renderAnswers, reportQuestion, settleYear, shareWithFeedback, showClaim, showPicture, store, toast } from "../game/client";

    // At most one vignette opportunity per minute: once this much time has passed, the next question
    // is opened as a real page load via a link click, which is what lets AdSense show a vignette ad.
    const AD_INTERVAL_MS = 60_000;
    /** How long a result stays up before the next question appears on its own; facts add reading time. */
    const SHOW_RIGHT_MS = 1200;
    const SHOW_WRONG_MS = 2600;
    const SHOW_REVEAL_MS = 1400;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const el = {
        main: $("main-content"),
        streak: $("streak"),
        best: $("best"),
        report: $<HTMLButtonElement>("report"),
        qText: $("q-text"),
        qCat: $("q-cat"),
        opts: $("opts"),
        card: $("card"),
        feedback: $("feedback"),
        reveal: $("reveal"),
        auto: $("auto"),
        next: $<HTMLAnchorElement>("next"),
        brag: $("brag"),
    };

    // The streak carries across pages, so a visitor arriving from a pin keeps it when they continue.
    let streak = Number(store.get("quiz.streak")) || 0;
    let best = Math.max(Number(store.get("quiz.bestStreak")) || 0, streak);
    /** Whether the current streak has beaten the previous best, which is when sharing it is offered. */
    let record = false;
    if (!store.get("quiz.adAt")) store.set("quiz.adAt", String(Date.now()));
    const adDue = () => Date.now() - (Number(store.get("quiz.adAt")) || 0) >= AD_INTERVAL_MS;
    /** Set when the next question will open as its own page (a vignette opportunity). */
    let pageTurn = false;
    /** Ids answered correctly on any visit; they are not asked again until everything has been solved. */
    const solved = new Set<string>();
    try {
        for (const id of JSON.parse(store.get("quiz.solved") ?? "[]")) if (typeof id === "string") solved.add(id);
    } catch {}
    // Ask the browser not to evict the saved progress (matters most for the installed PWA).
    navigator.storage?.persist?.().catch(() => {});
    /** Percent correct per question, filled in once loaded; until then every question counts as medium. */
    let rates = new Map<string, number>();
    fetchRates().then((r) => (rates = r));
    // Easy questions first, harder ones mixed in as the streak grows.
    const deck = createDeck("all", Math.random, solved, {
        correctRate: (id) => rates.get(id) ?? null,
        level: () => Math.min(0.75, 0.15 + streak * 0.05),
    });
    let question: Question | null = null;
    /** Drawn when an answer is given, so its picture can load while the result is showing. */
    let upcoming: Question | null = null;
    let locked = false;
    let advanceTimer: number | undefined;
    /** The streak the last wrong answer ended, offered as a brag. */
    let lostStreak = 0;

    function renderStats(bump = false) {
        el.streak.textContent = `🔥 ${ar(streak)}`;
        el.best.textContent = `★ ${ar(best)}`;
        if (bump) replay(el.streak, "bump");
    }

    /** Restarts a CSS animation class on `node`. */
    function replay(node: HTMLElement, cls: string) {
        node.classList.remove(cls);
        void node.offsetWidth;
        node.classList.add(cls);
    }

    /** The /q/<id> page's answer and links, which only apply to the question the page was opened on. */
    const qa = document.getElementById("qa");

    function renderQuestion(q: Question) {
        question = q;
        if (qa && q.id !== el.qText.dataset.id) qa.hidden = true;
        locked = false;
        el.qCat.textContent = `${CATEGORY_ICONS[q.category]} ${CATEGORY_LABELS[q.category]}`;
        el.qText.textContent = q.text;
        el.qText.classList.toggle("is-quote", q.isQuote);
        showClaim(q);
        renderAnswers(q, el.opts, guessYear);
        showPicture(q);
        el.feedback.textContent = "";
        el.feedback.className = "feedback";
        el.reveal.textContent = "";
        el.auto.classList.remove("on");
        el.next.hidden = true;
        el.next.href = "/";
        el.brag.hidden = true;
        el.report.disabled = false;
        pageTurn = false;
        replay(el.card, "card-in");
    }

    function nextQuestion() {
        clearTimeout(advanceTimer);
        advanceTimer = undefined;
        renderQuestion(upcoming ?? deck.next());
        upcoming = null;
        renderStats();
    }

    /** Draws the next question now and starts loading its picture. */
    function prepareNext() {
        upcoming = deck.next();
        if (upcoming.image) new Image().src = upcoming.image;
    }

    /** Moves on by itself after `ms`, with a draining bar; a tap anywhere moves on sooner. */
    function autoAdvance(ms: number) {
        el.auto.style.setProperty("--ms", `${ms}ms`);
        replay(el.auto, "on");
        advanceTimer = window.setTimeout(nextQuestion, ms);
    }

    /** Shows the "next" control and waits for it; when an ad is due it links to the next question's own page. */
    function showNext() {
        if (adDue()) {
            pageTurn = true;
            el.next.href = `/q/${upcoming!.id}/`;
        }
        el.next.hidden = false;
        el.next.focus();
    }

    /** Taps and keys after an answer: follow the "next" control if it is up, else skip the wait. */
    function proceed() {
        if (!locked) return;
        if (!el.next.hidden) el.next.click();
        else if (advanceTimer !== undefined) nextQuestion();
    }

    function answer(i: number) {
        if (locked || !question || question.year) return;
        const buttons = [...el.opts.querySelectorAll<HTMLButtonElement>(".opt")];
        buttons.forEach((b) => (b.disabled = true));
        buttons[question.answer].classList.add("right");
        if (i !== question.answer) buttons[i].classList.add("wrong");
        settle(i === question.answer);
    }

    function guessYear(guess: number) {
        if (locked || !question?.year) return;
        const { answer, tolerance } = question.year;
        const ok = Math.abs(guess - answer) <= tolerance;
        settleYear(el.opts, ok);
        settle(ok, guess === answer ? "بالضبط! 🎯" : `إجابتك ${ar(guess)}م`);
    }

    /** Scores the answer to the question on screen; `note` adds to the feedback (the year guessed). */
    function settle(ok: boolean, note = "") {
        if (locked || !question) return;
        locked = true;
        const q = question;
        recordAnswer(q.id, ok);
        countAnswer();

        if (ok) {
            streak++;
            solved.add(q.id);
            store.set("quiz.solved", JSON.stringify([...solved]));
            if (streak > best) {
                best = streak;
                record = streak > 1;
                store.set("quiz.bestStreak", String(best));
            }
        } else {
            navigator.vibrate?.([40, 60, 40]);
            deck.retry(q.id);
            lostStreak = streak;
            streak = 0;
        }
        store.set("quiz.streak", String(streak));
        renderStats(ok);

        el.feedback.textContent = [ok ? "صحيح ✓" : "خطأ ✗", note].filter(Boolean).join(" · ");
        el.feedback.className = ok ? "feedback ok" : "feedback bad";
        const reveal = q.reveal || (ok || q.year ? "" : `الإجابة الصحيحة: ${q.options[q.answer]}`);
        el.reveal.textContent = reveal;
        prepareNext();

        // A broken record is worth sharing: wait for the player instead of moving on.
        const brag = !ok && record && lostStreak >= 3;
        if (!ok) record = false;
        el.brag.hidden = !brag;
        if (brag || adDue()) showNext();
        else autoAdvance((ok ? SHOW_RIGHT_MS : SHOW_WRONG_MS) + (q.reveal ? SHOW_REVEAL_MS : 0));
    }

    el.next.addEventListener("click", (e) => {
        if (pageTurn) {
            // Let the browser follow the link so AdSense can interpose a vignette.
            store.set("quiz.adAt", String(Date.now()));
            return;
        }
        e.preventDefault();
        nextQuestion();
    });
    el.brag.addEventListener("click", () =>
        shareWithFeedback(`رقمي القياسي ${ar(lostStreak)} إجابات صحيحة متتالية 🔥 في اختبار الهلال. هل تتفوق عليّ؟`, `${SITE}/`),
    );
    el.report.addEventListener("click", async () => {
        if (!question) return;
        el.report.disabled = true;
        const sent = await reportQuestion(question.id);
        toast(sent ? "شكرًا! سنراجع هذا السؤال" : "تعذّر الإرسال، حاول لاحقًا");
        if (!sent) el.report.disabled = false;
    });
    el.opts.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".opt");
        if (b && !b.disabled) answer(Number(b.dataset.i));
    });
    // Anywhere that isn't a control moves on once the question is answered.
    el.main.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("button, a, input")) proceed();
    });
    document.addEventListener("keydown", (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const idx = e.key.length === 1 ? Math.max("1234".indexOf(e.key), "١٢٣٤".indexOf(e.key)) : -1;
        if (idx >= 0) {
            const b = el.opts.children[idx] as HTMLButtonElement | undefined;
            if (b && !b.disabled) answer(idx);
        } else if ((e.key === "Enter" || e.key === " ") && locked && !(document.activeElement as HTMLElement | null)?.closest("button, a")) {
            e.preventDefault();
            proceed();
        }
    });

    // A pinned question (already rendered server-side with the same seeded options) or a random start.
    const startId = el.qText.dataset.id;
    const first = (startId && questionById(startId)) || null;
    if (first) {
        renderQuestion(first);
        renderStats();
    } else nextQuestion();
</script>
