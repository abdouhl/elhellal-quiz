---
import { CATEGORY_ICONS, CATEGORY_LABELS, questionById } from "../game/engine";
import "../styles/quiz.css";

export interface Props {
    /** Start on this fixed question (used by /q/[id]); otherwise start on a random one. */
    initialId?: string;
}

const { initialId } = Astro.props;
const initial = initialId ? questionById(initialId) : null;
---

<main id="main-content" class="app">
    <div class="topbar" aria-live="polite">
        <span id="best" class="chip" title="الأفضل">★ …</span>
        <span id="stat" class="chip chip-n" title="النتيجة">…</span>
        <span class="topbar-end">
            <a class="chip chip-btn" href="/daily/">📅 تحدي اليوم</a>
            <button type="button" id="share" class="chip chip-btn">تحدَّ صديقًا ↗</button>
        </span>
    </div>

    <section id="card" class="card">
        <p id="q-cat" class="q-cat">{initial && `${CATEGORY_ICONS[initial.category]} ${CATEGORY_LABELS[initial.category]}`}</p>
        <figure id="q-fig" class="q-fig" data-kind={initial?.category} hidden={!initial?.image}>
            <img src={initial?.image} alt="صورة السؤال" decoding="async" />
            <figcaption><a href={initial?.creditUrl || "#"} target="_blank" rel="noopener" hidden={!initial?.credit}>{initial?.credit && `📷 ${initial.credit}`}</a></figcaption>
        </figure>
        <h1 id="q-text" class:list={["q-text", { "is-quote": initial?.isQuote, "has-pic": initial?.image }]} data-id={initial ? initialId : undefined}>
            {initial ? initial.text : "جارٍ التحميل…"}
        </h1>
        <p id="q-claim" class="q-claim" hidden={!initial?.claim}>{initial?.claim && `«${initial.claim}»`}</p>
    </section>

    <div id="opts" class="opts" role="group" aria-label="الخيارات">
        {
            initial?.options.map((text, i) => (
                <button type="button" class="opt" data-i={i}>
                    {text}
                </button>
            ))
        }
    </div>

    <div class="foot">
        <p id="feedback" class="feedback" role="status"></p>
        <button type="button" id="brag" class="brag" hidden>شارك سلسلتك 🔥</button>
        <a id="next" class="next" href="/" hidden>التالي ←</a>
    </div>
    <p id="crowd" class="crowd"></p>

    <p class="hint">اضغط ١ – ٤ للإجابة، وEnter للسؤال التالي.</p>
    <noscript><p class="noscript">هذه اللعبة تحتاج إلى تفعيل جافاسكربت.</p></noscript>
</main>

<script>
    import { CATEGORY_ICONS, CATEGORY_LABELS, createDeck, difficultyFor, penaltyFor, pointsFor, questionById, questionTitle, timeLimitFor } from "../game/engine";
    import type { Question } from "../game/engine";
    import { SITE, ar, crowdLine, crowdPercent, fetchCrowd, recordAnswer, renderAnswers, settleYear, shareWithFeedback, showClaim, showPicture, store } from "../game/client";
    import type { Crowd } from "../game/client";

    const START_SCORE = 500;
    // At most one vignette opportunity per minute: once this much time has passed, the next question
    // is opened as a real page load via a link click, which is what lets AdSense show a vignette ad.
    const AD_INTERVAL_MS = 60_000;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const el = {
        stat: $("stat"),
        best: $("best"),
        qCat: $("q-cat"),
        qText: $("q-text"),
        opts: $("opts"),
        card: $("card"),
        feedback: $("feedback"),
        next: $<HTMLAnchorElement>("next"),
        crowd: $("crowd"),
        share: $("share"),
        brag: $("brag"),
    };

    // The score carries across pages, so a visitor arriving from a pin keeps it when they continue.
    const savedScore = store.get("quiz.score");
    let score = savedScore === null ? START_SCORE : Number(savedScore) || 0;
    let best = Math.max(Number(store.get("quiz.best")) || 0, score);
    let streak = Number(store.get("quiz.streak")) || 0;
    if (!store.get("quiz.adAt")) store.set("quiz.adAt", String(Date.now()));
    const adDue = () => Date.now() - (Number(store.get("quiz.adAt")) || 0) >= AD_INTERVAL_MS;
    /** Set when the next question will open as its own page (a vignette opportunity). */
    let pageTurn = false;
    /** Ids answered correctly on any visit; they are not asked again until everything has been solved. */
    const solved = new Set<string>();
    try {
        for (const id of JSON.parse(store.get("quiz.solved") ?? "[]")) if (typeof id === "string") solved.add(id);
    } catch {}
    // Ask the browser not to evict the saved progress (matters most for the installed PWA).
    navigator.storage?.persist?.().catch(() => {});
    const deck = createDeck("all", Math.random, solved);
    /** When the current question appeared, for the speed bonus. */
    let shownAt = 0;
    /** Crowd totals for the question on screen, fetched as it appears, to price it by difficulty. */
    let before: Crowd | null = null;
    let question: Question | null = null;
    let locked = false;
    let advanceTimer: number | undefined;
    /** Crowd totals for the question on screen, once it has been answered. */
    let crowd: Crowd | null = null;
    /** The streak the last wrong answer ended, offered as a brag. */
    let lostStreak = 0;

    function renderStats() {
        el.stat.textContent = ar(score);
        el.best.textContent = `★ ${ar(best)}`;
    }

    /** The /q/<id> page's answer and links, which only apply to the question the page was opened on. */
    const qa = document.getElementById("qa");

    function renderQuestion(q: Question) {
        question = q;
        if (qa && q.id !== el.qText.dataset.id) qa.hidden = true;
        locked = false;
        el.qCat.textContent = `${CATEGORY_ICONS[q.category]} ${CATEGORY_LABELS[q.category]}`;
        el.qText.textContent = q.text;
        el.qText.classList.toggle("is-quote", q.isQuote);
        showClaim(q);
        renderAnswers(q, el.opts, guessYear);
        el.feedback.textContent = "";
        el.feedback.className = "feedback";
        el.next.hidden = true;
        el.next.href = "/";
        el.crowd.textContent = "";
        el.brag.hidden = true;
        crowd = null;
        before = null;
        fetchCrowd(q.id).then((c) => {
            if (question === q) before = c;
        });
        shownAt = performance.now();
        // The clock starts when the picture is visible, not while it downloads.
        showPicture(q, () => {
            if (question === q && !locked) shownAt = performance.now();
        });
        pageTurn = false;
        el.card.classList.remove("card-in");
        void el.card.offsetWidth;
        el.card.classList.add("card-in");
    }

    function nextQuestion() {
        clearTimeout(advanceTimer);
        renderQuestion(deck.next());
        renderStats();
    }

    /** Shows the "next" control; when an ad is due it links to the next question's own page. */
    function showNext() {
        if (adDue()) {
            pageTurn = true;
            el.next.href = `/q/${deck.next().id}/`;
        }
        el.next.hidden = false;
        el.next.focus();
    }

    function answer(i: number) {
        if (locked || !question || question.year) return;
        const buttons = [...el.opts.querySelectorAll<HTMLButtonElement>(".opt")];
        buttons.forEach((b) => (b.disabled = true));
        buttons[question.answer].classList.add("right");
        if (i !== question.answer) buttons[i].classList.add("wrong");
        settle(i === question.answer);
    }

    function guessYear(guess: number) {
        if (locked || !question?.year) return;
        const { answer, tolerance } = question.year;
        const ok = Math.abs(guess - answer) <= tolerance;
        settleYear(el.opts, ok);
        settle(ok, guess === answer ? "بالضبط! 🎯" : `إجابتك ${ar(guess)}م`);
    }

    /** Scores the answer to the question on screen; `note` adds to the feedback (the year guessed). */
    function settle(ok: boolean, note = "") {
        if (locked || !question) return;
        locked = true;
        const q = question;
        const timeLeft = 1 - (performance.now() - shownAt) / 1000 / timeLimitFor(q);
        const difficulty = difficultyFor(crowdPercent(before));
        const reveal = [note, q.reveal].filter(Boolean).join(" · ");
        recordAnswer(q.id, ok).then((c) => {
            if (question !== q) return;
            crowd = c;
            el.crowd.textContent = crowdLine(c);
        });

        if (ok) {
            streak++;
            store.set("quiz.streak", String(streak));
            solved.add(q.id);
            store.set("quiz.solved", JSON.stringify([...solved]));
            const pts = pointsFor(streak, timeLeft, difficulty);
            score += pts;
            store.set("quiz.score", String(score));
            if (score > best) {
                best = score;
                store.set("quiz.best", String(best));
            }
            let msg = `إجابة صحيحة! +${ar(pts)}`;
            if (timeLeft > 0.6) msg += " ⚡";
            if (streak >= 3) msg += ` 🔥 ${ar(streak)} متتالية`;
            el.feedback.textContent = reveal ? `${msg} — ${reveal}` : msg;
            el.feedback.className = "feedback ok";
            renderStats();
            if (adDue()) showNext();
            // Leave time to read the facts behind the answer.
            else advanceTimer = window.setTimeout(nextQuestion, reveal ? 3000 : 1300);
            return;
        }

        lostStreak = streak;
        el.brag.hidden = lostStreak < 3;
        streak = 0;
        store.set("quiz.streak", "0");
        const lost = Math.min(penaltyFor(timeLeft, difficulty), score);
        score -= lost;
        store.set("quiz.score", String(score));
        el.feedback.textContent = `${lost ? `−${ar(lost)} · ` : ""}${reveal || `الإجابة الصحيحة: ${q.options[q.answer]}`}`;
        el.feedback.className = "feedback bad";
        showNext();
        renderStats();
    }

    el.next.addEventListener("click", (e) => {
        if (pageTurn) {
            // Let the browser follow the link so AdSense can interpose a vignette.
            store.set("quiz.adAt", String(Date.now()));
            return;
        }
        e.preventDefault();
        nextQuestion();
    });
    el.share.addEventListener("click", () => {
        const q = question;
        if (!q) return;
        const pct = crowdPercent(crowd);
        const hook = pct !== null && pct <= 50 ? `${ar(pct)}٪ فقط أجابوا بشكل صحيح. هل تعرف الإجابة؟` : "هل تعرف الإجابة؟ 🤔";
        const text = q.image ? `${q.text} 👀` : questionTitle(q);
        shareWithFeedback(`${text}\n\n${hook}`, `${SITE}/q/${q.id}/`);
    });
    el.brag.addEventListener("click", () =>
        shareWithFeedback(`حققت ${ar(lostStreak)} إجابات صحيحة متتالية 🔥 في اختبار الهلال. هل تتفوق عليّ؟`, `${SITE}/`),
    );
    el.opts.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".opt");
        if (b && !b.disabled) answer(Number(b.dataset.i));
    });
    document.addEventListener("keydown", (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const idx = e.key.length === 1 ? Math.max("1234".indexOf(e.key), "١٢٣٤".indexOf(e.key)) : -1;
        if (idx >= 0) {
            const b = el.opts.children[idx] as HTMLButtonElement | undefined;
            if (b && !b.disabled) answer(idx);
        } else if (e.key === "Enter" && !el.next.hidden && document.activeElement !== el.next) el.next.click();
    });

    // A pinned question (already rendered server-side with the same seeded options) or a random start.
    const startId = el.qText.dataset.id;
    const first = (startId && questionById(startId)) || null;
    if (first) {
        renderQuestion(first);
        renderStats();
    } else nextQuestion();
</script>
